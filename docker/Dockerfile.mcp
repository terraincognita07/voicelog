# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0
# Version reported in the MCP initialize handshake. Passed in from the
# build host's `git describe` (see docker-compose.yml / docs/RELEASING.md)
# so the tag and the handshake can't drift. Defaults to "dev".
ARG VERSION=dev
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath \
	-ldflags "-s -w -X github.com/terraincognita07/voicelog/internal/mcp.serverVersion=${VERSION}" \
	-o /out/mcp ./cmd/mcp

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mcp /usr/local/bin/voicelog-mcp
ENTRYPOINT ["/usr/local/bin/voicelog-mcp"]
