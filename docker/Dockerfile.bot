# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags '-s -w' -o /out/bot ./cmd/bot

FROM alpine:3.23
RUN apk add --no-cache ffmpeg tzdata ca-certificates \
 && addgroup -S -g 10000 voicelog \
 && adduser  -S -G voicelog -u 10000 voicelog
COPY --from=build /out/bot /usr/local/bin/voicelog-bot
USER voicelog:voicelog
ENTRYPOINT ["/usr/local/bin/voicelog-bot"]
