# Telegram bot
BOT_TOKEN=
ALLOWED_USER_ID=

# Shared SQLite path (inside containers; bind-mounted from ./data on host)
DB_PATH=/data/voicelog.db

# Whisper.cpp server endpoint (internal compose network)
WHISPER_URL=http://whisper:8080/inference

# MCP HTTP server
MCP_PORT=8081
# Shared bearer token required by every MCP request.
# Generate a strong one:  openssl rand -hex 32
# Minimum 16 chars; the server refuses to start otherwise.
MCP_TOKEN=

# Timezone for log timestamps and Telegram /pending /recent formatting
TZ=Europe/Moscow

# Bot reply language: en (default) or ru. Affects only user-facing replies;
# command names (/pending /recent /delete /vocab) stay the same in any locale.
BOT_LOCALE=en

# Optional whisper "initial prompt" — a free-form hint string biasing the
# decoder toward names/jargon. User-managed vocabulary (/vocab in the bot)
# is appended after this. Leave empty to rely on vocabulary alone.
WHISPER_PROMPT=

# Audio retention. 0 (default) = disabled; original audio is deleted right
# after transcription. >0 = keep the .oga (~50–100 KB / minute of voice)
# at AUDIO_DIR for that many days. A background janitor sweeps every 6h
# and deletes files older than the window. NOTE: retained audio is
# sensitive at rest — encrypt the host disk if this matters to you.
AUDIO_RETENTION_DAYS=0
AUDIO_DIR=/data/audio

# Hallucination detector threshold. Whisper returns per-segment
# no_speech_prob ∈ [0, 1]. If the FIRST segment's value exceeds this,
# the bot flags the note as suspect (likely silence / music / not speech)
# and warns the user in the saved-reply. 0.6 is whisper.cpp's
# conventional cutoff. Raise to be stricter (fewer warnings), lower to
# be looser (more warnings).
HALLUCINATION_THRESHOLD=0.6

# Disk-full guard. Before each voice capture the bot checks free space
# on the data filesystem. Below this many MB → refuse the capture,
# warn the user, and log a Warn line for external monitoring. Set to 0
# to disable. Default 500 MB.
MIN_FREE_DISK_MB=500

# DB maintenance (mcp container): unless set to any non-empty value, the mcp process runs
# a weekly WAL checkpoint and a monthly VACUUM in the background.
DB_MAINTENANCE_DISABLED=

# UID/GID inside bot and mcp containers — must own ./data on the host
# Find yours with:  id -u && id -g
HOST_UID=1000
HOST_GID=1000
