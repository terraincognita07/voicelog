# Telegram bot
BOT_TOKEN=
ALLOWED_USER_ID=

# Shared SQLite path (inside containers; bind-mounted from ./data on host)
DB_PATH=/data/voicelog.db

# Whisper.cpp server endpoint (internal compose network)
WHISPER_URL=http://whisper:8080/inference

# MCP HTTP server
MCP_PORT=8081
# Shared bearer token required by every MCP request.
# Generate a strong one:  openssl rand -hex 32
# Minimum 16 chars; the server refuses to start otherwise.
MCP_TOKEN=

# Timezone for log timestamps and Telegram /pending /recent formatting
TZ=Europe/Moscow

# UID/GID inside bot and mcp containers — must own ./data on the host
# Find yours with:  id -u && id -g
HOST_UID=1000
HOST_GID=1000
